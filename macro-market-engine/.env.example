# Copy this file to `.env` (which is git-ignored) and fill in values.
# In Fabric, prefer storing secrets in Azure Key Vault and referencing them via
# notebookutils.credentials.getSecret(); these env vars are for LOCAL dev/tests.

# FRED (free): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SEC EDGAR requires a descriptive User-Agent (company/app + contact email).
# See https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=MacroMarketEngine/1.0 (your_name your_email@example.com)

# Optional: World Bank / IMF have no key but you can override base URLs for mirrors.
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2
IMF_BASE_URL=https://www.imf.org/external/datamapper/api/v1

# Local dev storage root (ignored in Fabric, where paths resolve to OneLake)
LOCAL_LAKE_ROOT=./data
