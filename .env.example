# Exchange Rate API Settings
EXCHANGE_RATE_API_KEY=your_api_key_here
BASE_CURRENCY=GBP

# Database Settings (Local PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finance_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Microsoft Azure (optional — retail ETL cloud mirror)
USE_AZURE=false
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=finance-data
# Example: mssql+pyodbc://user:pass@server.database.windows.net:1433/finance_dw?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes
AZURE_SQL_CONNECTION_STRING=

# Snowflake (optional)
USE_SNOWFLAKE=false
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=FINANCE_DW
SNOWFLAKE_SCHEMA=PUBLIC

# App Settings
LOG_LEVEL=INFO
DEBUG=True